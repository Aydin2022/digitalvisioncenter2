

# APP_URL: The URL where this applet is hosted.
APP_URL=https://digitalvisioncenter2.vercel.app

# SUPABASE_URL: The API URL of your Supabase project.
SUPABASE_URL=https://your-supabase-project.supabase.co

# SUPABASE_ANON_KEY: The public anonymous API key for your Supabase project.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SUPABASE_SERVICE_ROLE_KEY: The service_role secret key for administrative actions.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ZAINCASH_CLIENT_ID: Your ZainCash Merchant Client ID
ZAINCASH_CLIENT_ID=your_zaincash_client_id_here

# ZAINCASH_CLIENT_SECRET: Your ZainCash Merchant Secret Key
ZAINCASH_CLIENT_SECRET=your_zaincash_client_secret_here

# ZAINCASH_MSISDN: Your ZainCash Wallet Number (e.g. 9647708506036)
ZAINCASH_MSISDN=your_zaincash_msisdn_here

# ZAINCASH_API_URL: ZainCash API URL (e.g. https://pg-api.zaincash.iq or https://test.zaincash.iq)
ZAINCASH_API_URL=https://pg-api.zaincash.iq

# Mailtrap Transactional Email Service Token
MAILTRAP_TOKEN=your_mailtrap_token_here
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alternatively for Gmail App Password:
GMAIL_USER=
GMAIL_APP_PASSWORD=


